{
  "name": "pokemon-team-builder",
  "version": "0.1.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build",
    "test": "ng test",
    "lint": "ng lint",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "create-interface": "ng generate interface --type interface --path=src/app/shared/interfaces",
    "create-pipe": "ng generate pipe --type-separator . --skip-tests true --path=src/app/shared/pipes",
    "create-guard": "ng generate guard --type-separator . --skip-tests true --path=src/app/core/guards",
    "create-interceptor": "ng generate interceptor --type-separator . --skip-tests true --path=src/app/core/interceptors",
    "create-service": "ng generate service --add-type-to-class-name true --skip-tests true --type service --path=src/app/core/services",
    "create-feature": "ng generate component --add-type-to-class-name true --skip-tests true --path=src/app/features --change-detection OnPush --standalone true",
    "create-component": "ng generate component --add-type-to-class-name true --skip-tests true --path=src/app/shared/components --change-detection OnPush --standalone true",
    "deploy": "npm run build && wrangler deploy",
    "preview": "npm run build && wrangler dev"
  },
  "private": true,
  "packageManager": "npm@11.14.1",
  "dependencies": {
    "@angular/common": "^21.2.0",
    "@angular/compiler": "^21.2.0",
    "@angular/core": "^21.2.0",
    "@angular/forms": "^21.2.0",
    "@angular/platform-browser": "^21.2.0",
    "@angular/router": "^21.2.0",
    "@primeuix/themes": "^2.0.3",
    "jwt-decode": "^4.0.0",
    "primeicons": "^7.0.0",
    "primeng": "^21.1.8",
    "rxjs": "~7.8.0",
    "tailwindcss-primeui": "^0.6.1",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular/build": "^21.2.10",
    "@angular/cli": "^21.2.10",
    "@angular/compiler-cli": "^21.2.0",
    "@tailwindcss/postcss": "^4.1.12",
    "angular-eslint": "^21.4.0",
    "eslint": "^9.39.5",
    "jsdom": "^28.0.0",
    "postcss": "^8.5.3",
    "prettier": "^3.8.1",
    "tailwindcss": "^4.1.12",
    "typescript": "~5.9.2",
    "typescript-eslint": "^8.68.0",
    "vitest": "^4.0.8",
    "wrangler": "^4.97.0"
  }
}
